# ─── Contact form (Nodemailer) ─────────────────────────────────────
# Emails are delivered to CONTACT_TO (default: info@siliconpk.com)

CONTACT_TO=info@siliconpk.com
CONTACT_FROM="Silicon International Website" <noreply@siliconpk.com>

# SMTP — use your domain email (cPanel / Hostinger / Zoho / Google Workspace)
SMTP_HOST=mail.siliconpk.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@siliconpk.com
SMTP_PASS=your_email_password_or_app_password
